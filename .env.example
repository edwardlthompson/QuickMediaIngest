# Optional environment variables for local development and release scripts.
# Copy to .env and fill in values. Never commit .env.

# Template update checker upstream (optional override)
# TEMPLATE_UPSTREAM=edwardlthompson/agent-project-bootstrap

# GitHub token for local release scripts (build_and_push.bat, gh CLI)
# GITHUB_TOKEN=ghp_...

# Project-specific variables (add below)
# API_BASE_URL=http://localhost:3000
# LOG_LEVEL=info
