<UserControl x:Class="QuickMediaIngest.Controls.FeedbackOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:QuickMediaIngest"
    xmlns:loc="clr-namespace:QuickMediaIngest.Localization">
    <Grid Visibility="{Binding ShowFeedbackDialog, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="990">
        <Rectangle Margin="-10" Stretch="Fill" IsHitTestVisible="False">
            <Rectangle.Fill>
                <VisualBrush Visual="{Binding BlurBackdropSource, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Stretch="Fill"/>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="14" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>
        <Border Margin="-10" Background="#35303030" IsHitTestVisible="False"/>
        <Border Width="560" Padding="18" CornerRadius="8"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                AutomationProperties.Name="{Binding FeedbackTitle}"
                AutomationProperties.AutomationId="FeedbackDialog">
            <StackPanel>
                <TextBlock Text="{Binding FeedbackTitle}" Style="{StaticResource AppHeadingTextStyle}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding FeedbackDescription, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,0,0,10"
                         AutomationProperties.Name="{Binding FeedbackTitle}"/>
                <TextBlock Text="{loc:Loc Feedback_Preview}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding FeedbackPreview, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="120" MaxHeight="220"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding FeedbackGitHubReason}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Feedback_Copy}" Command="{Binding CopyFeedbackCommand}"
                            Style="{StaticResource DialogOutlinedButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Feedback_OpenGitHub}" Command="{Binding OpenFeedbackGitHubCommand}"
                            IsEnabled="{Binding FeedbackCanOpenGitHub}"
                            Style="{StaticResource DialogPrimaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Feedback_Discard}" Command="{Binding DiscardFeedbackCommand}"
                            Style="{StaticResource DialogOutlinedButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
